#!/bin/sh
# Aph AppImage launcher — seed first-run prefs, then run Firefox with the
# Aph profile. Seeding lives in packaging/seed-profile.sh (single POSIX
# source of truth; aph.bat mirrors it, dev.py is the Python equivalent).
set -eu
HERE="$(dirname "$(readlink -f "$0")")"
APH_PROFILE="${APH_PROFILE:-$HOME/.config/aph/profile}"
mkdir -p "$APH_PROFILE"
"$HERE/usr/share/aph/seed-profile.sh" "$HERE/usr/share/aph" "$APH_PROFILE"
exec "$HERE/usr/bin/firefox" --profile "$APH_PROFILE" "$@"
