#!/bin/sh
# Aph AppImage launcher — mirrors scripts/dev.py: seed first-run prefs,
# then run Firefox with the Aph profile.
set -eu
HERE="$(dirname "$(readlink -f "$0")")"
APH_PROFILE="${APH_PROFILE:-$HOME/.aph/profile}"
mkdir -p "$APH_PROFILE"
# Seed-once defaults: never overwrite an existing user.js (user edits persist).
if [ ! -f "$APH_PROFILE/user.js" ]; then cp -f "$HERE/usr/share/aph/user.js" "$APH_PROFILE/user.js"; fi
# Seed-once menu accents (dev.py parity): never overwrite user edits.
mkdir -p "$APH_PROFILE/chrome"
if [ ! -f "$APH_PROFILE/chrome/userChrome.css" ]; then cp -f "$HERE/usr/share/aph/userChrome.css" "$APH_PROFILE/chrome/userChrome.css"; fi
exec "$HERE/usr/bin/firefox" --profile "$APH_PROFILE" --no-remote "$@"
