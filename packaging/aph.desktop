[Desktop Entry]
Name=Aph
GenericName=Web Browser
Comment=Aph Browser — Firefox-based, workspaces-first
Exec=firefox %u
Icon=aph
Type=Application
Categories=Network;WebBrowser;
Terminal=false
# NOTE: must stay `firefox` — launchers exec the stock firefox binary
# directly (no --class override exists), so the window's WM_CLASS is
# firefox. Changing this orphans the running window from its launcher
# icon (duplicate/generic dock icon). True per-app grouping needs a
# binary rename, which is out of scope (remote/profile semantics).
StartupWMClass=firefox
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
