#!/bin/sh
# Aph Flatpak launcher — seed first-run prefs, then run the bundled
# Firefox with the Aph profile. Seeding lives in packaging/seed-profile.sh
# (single POSIX source of truth; aph.bat mirrors it, dev.py is the Python
# equivalent).
set -eu
APH_PROFILE="${APH_PROFILE:-$HOME/.config/aph/profile}"
mkdir -p "$APH_PROFILE"
/app/share/aph/seed-profile.sh /app/share/aph "$APH_PROFILE"
# No --no-remote so external links (%u) reuse the running instance.
exec "/app/aph/firefox" --profile "$APH_PROFILE" "$@"
