<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata for the Aph Flatpak. Update project_license once the
     repo picks a license (MPL-2.0 here covers the redistributed Firefox bits). -->
<component type="desktop-application">
  <id>io.github.aph_browser.Aph</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MPL-2.0</project_license>
  <name>Aph</name>
  <summary>Firefox-based, workspaces-first web browser</summary>
  <developer>
    <name>Aph Browser</name>
  </developer>
  <keywords>
    <keyword>browser</keyword>
    <keyword>web</keyword>
    <keyword>workspaces</keyword>
    <keyword>firefox</keyword>
    <keyword>privacy</keyword>
  </keywords>
  <url type="homepage">https://aph-browser.github.io/</url>
  <url type="bugtracker">https://github.com/aph-browser/aph/issues</url>
  <url type="help">https://github.com/aph-browser/aph</url>
  <description>
    <p>
      Aph is a Firefox-based browser with native workspace, command-palette,
      and tab-stash overrides plus hardened privacy defaults.
    </p>
    <p>
      Organize tabs into nine workspaces per window, jump with a
      Raycast-style command palette, park tabs in the stash with
      workspace and container restore, and browse with telemetry and
      Normandy switched off.
    </p>
  </description>
  <launchable type="desktop-id">io.github.aph_browser.Aph.desktop</launchable>
  <icon type="stock">io.github.aph_browser.Aph</icon>
  <categories>
    <category>Network</category>
    <category>WebBrowser</category>
  </categories>
  <provides>
    <mediatype>text/html</mediatype>
    <mediatype>application/xhtml+xml</mediatype>
    <mediatype>x-scheme-handler/http</mediatype>
    <mediatype>x-scheme-handler/https</mediatype>
  </provides>
  <releases>
    <release version="0.3.0" date="2026-09-29"/>
  </releases>
</component>
