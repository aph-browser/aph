{
  "policies": {
    "DisableTelemetry": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    "DisableFeedbackCommands": true,
    "OverrideFirstRunPage": "https://aph-browser.github.io/",
    "OverridePostUpdatePage": "",
    "DontCheckDefaultBrowser": true,
    "DisableDefaultBrowserAgent": true,
    "DisableRemoteImprovements": true,
    "AppUpdateURL": "https://localhost",
    "WebsiteFilter": {
      "Block": [
        "https://localhost/*"
      ],
      "Exceptions": [
        "https://localhost/*"
      ]
    },
    "DisableAppUpdate": true,
    "NoDefaultBookmarks": true,
    "SkipTermsOfUse": true,
    "HttpsOnlyMode": "enabled",
    "AIControls": {
      "Translations": {
        "Value": "available"
      },
      "PDFAltText": {
        "Value": "blocked"
      },
      "SmartTabGroups": {
        "Value": "blocked"
      },
      "LinkPreviewKeyPoints": {
        "Value": "blocked"
      },
      "SidebarChatbot": {
        "Value": "blocked"
      },
      "SmartWindow": {
        "Value": "blocked"
      }
    },
    "FirefoxHome": {
      "Weather": false,
      "TopSites": false,
      "SponsoredTopSites": false,
      "Highlights": false,
      "Stories": false,
      "SponsoredStories": false
    },
    "FirefoxSuggest": {
      "WebSuggestions": false,
      "SponsoredSuggestions": false,
      "ImproveSuggest": false
    },
    "LocalNetworkAccess": {
      "Enabled": true,
      "BlockTrackers": true,
      "EnablePrompting": true
    },
    "Permissions": {
      "Notifications": {
        "BlockNewRequests": true
      },
      "Location": {
        "BlockNewRequests": true
      }
    },
    "EnableTrackingProtection": {
      "Category": "standard",
      "Locked": false,
      "BaselineExceptions": true,
      "ConvenienceExceptions": true
    },
    "AutofillAddressEnabled": false,
    "AutofillCreditCardEnabled": false,
    "SearchEngines": {
      "Default": "DuckDuckGo"
    },
    "CaptivePortal": true,
    "UserMessaging": {
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "UrlbarInterventions": false,
      "SkipOnboarding": true,
      "MoreFromMozilla": false,
      "FirefoxLabs": false,
      "WhatsNew": false
    },
    "EncryptedMediaExtensions": {
      "Enabled": true
    },
    "SupportMenu": {
      "Title": "Aph",
      "URL": "https://aph-browser.github.io/"
    },
    "ExtensionSettings": {
      "*": {
        "installation_mode": "allowed",
        "default_area": "menupanel"
      },
      "uBlock0@raymondhill.net": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi",
        "installation_mode": "normal_installed",
        "private_browsing": true,
        "default_area": "navbar"
      }
    },
    "3rdparty": {
      "Extensions": {
        "uBlock0@raymondhill.net": {
          "adminSettings": {
            "userSettings": {
              "externalLists": "https://raw.githubusercontent.com/DandelionSprout/adfilt/master/LegitimateURLShortener.txt"
            },
            "selectedFilterLists": [
              "user-filters",
              "ublock-filters",
              "ublock-badware",
              "ublock-privacy",
              "ublock-quick-fixes",
              "ublock-unbreak",
              "easylist",
              "easyprivacy",
              "urlhaus-1",
              "plowe-0",
              "curben-phishing",

              "adguard-spyware-url",
              "https://raw.githubusercontent.com/DandelionSprout/adfilt/master/LegitimateURLShortener.txt",

              "ublock-cookies-easylist",
              "fanboy-cookiemonster",
              "ublock-annoyances",

              "fanboy-ai-suggestions",
              "easylist-chat",
              "easylist-newsletters",
              "easylist-notifications",
              "easylist-annoyances",

              "fanboy-social"
            ]
          }
        }
      }
    }
  }
}
